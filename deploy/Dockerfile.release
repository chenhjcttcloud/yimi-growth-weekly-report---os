# Stage only server/, scripts/, db/, src/data/, package.json and prebuilt web/.
# Retain previous images and assets. Previous containers are stopped and renamed.
ARG BASE_IMAGE=emie-growth-os:production-20261026-userid
FROM ${BASE_IMAGE}
ARG RELEASE_ID
ARG SOURCE_REVISION
LABEL cn.emie.growth.release=${RELEASE_ID} org.opencontainers.image.revision=${SOURCE_REVISION}
COPY --chown=node:node server /app/server
COPY --chown=node:node scripts /app/scripts
COPY --chown=node:node db /app/db
COPY --chown=node:node src/data /app/src/data
COPY --chown=node:node package.json /app/package.json
COPY --chown=node:node web /app/dist
