# 正式生产环境；SESSION_SECRET 必须独立生成并妥善保留。
# 已有数据库的加密凭据依赖原 SESSION_SECRET，不能直接替换。
SESSION_SECRET=replace-with-production-secret
AUTH_MODE=feishu
DEV_VIEW_SWITCH_ENABLED=false
BASE_URL=https://growth.emie.cn
LARK_REPORT_AUTO_SYNC_ENABLED=true
LARK_AUTH_MONITOR_ENABLED=false
FEISHU_TASK_CREATE_ENABLED=false
WEEKLY_REMINDER_ENABLED=false
WEEKLY_UPDATE_REMINDER_ENABLED=false
SCORING360_REMINDER_ENABLED=false
SCORING360_LAUNCH_MODE=manual
